{
  "openapi": "3.1.0",
  "info": {
    "title": "MeatyMusic + Pipes local review workbench",
    "version": "0.4.0",
    "description": "Implemented local HTTP transport only. Not a production MeatyMusic API, provider API or live estate service."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8786",
      "description": "Local review instance"
    }
  ],
  "security": [
    {
      "localBearer": []
    },
    {
      "localCookie": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Bootstrap local browser session",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML + HttpOnly SameSite cookie; CSRF value embedded in page"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Local health, not provider health",
        "security": [],
        "responses": {
          "200": {
            "description": "Local status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "live_generation": {
                      "const": false
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "mode",
                    "live_generation"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "summary": "Read local workspace without idempotency receipts",
        "responses": {
          "200": {
            "description": "Workspace metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "summary": "Read editorial instrument palette",
        "responses": {
          "200": {
            "description": "Instrument list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instruments": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "instruments"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "summary": "Prototype capability declarations, no remote probe",
        "responses": {
          "200": {
            "description": "Capability declaration",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This implemented prototype OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands": {
      "post": {
        "summary": "Shared domain command surface",
        "description": "Reads require operation/input. Mutations also require expected_sequence and idempotency_key. Browser requests need cookie and X-MM-CSRF; local CLI uses bearer. take.register is blocked; use uploads. generation.submit returns 501. No external calls.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Prototype command envelope",
                "description": "Implemented transport envelope. Mutations additionally require sequence and idempotency; operation validation lives in domain handlers.",
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "type": "object"
                  },
                  "expected_sequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "operation"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authentication or CSRF failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Host/origin/operation refused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Unknown record or operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Stale workspace or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Domain validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "501": {
            "description": "Not implemented",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads": {
      "post": {
        "summary": "Register unchanged local audio bytes",
        "description": "40 MB maximum. Browser supplies decoded duration except WAV header duration is measured by server. Query is metadata, raw request body is audio. Idempotency-Key and current sequence required. Full robust decoding remains production work.",
        "parameters": [
          {
            "in": "query",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "handoff_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sequence",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "duration",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered take",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Invalid audio/association",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/audio/{artifact}": {
      "get": {
        "summary": "GET original audio bytes",
        "parameters": [
          {
            "in": "path",
            "name": "artifact",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}\\.(wav|mp3|ogg|flac|m4a)$"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original content or metadata"
          },
          "206": {
            "description": "Single explicit byte range"
          },
          "416": {
            "description": "Unsupported/out of range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "HEAD original audio bytes",
        "parameters": [
          {
            "in": "path",
            "name": "artifact",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}\\.(wav|mp3|ogg|flac|m4a)$"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original content or metadata"
          },
          "206": {
            "description": "Single explicit byte range"
          },
          "416": {
            "description": "Unsupported/out of range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "message"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/workbench-contract.json": {
      "get": {
        "summary": "Implemented workbench state JSON Schema",
        "responses": {
          "200": {
            "description": "JSON Schema draft 2020-12"
          }
        }
      }
    },
    "/api/renders/{filename}": {
      "get": {
        "summary": "Serve local diagnostic MIDI/WAV by plan hash; supports bounded range reads",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}\\.(wav|mid)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete local render"
          },
          "206": {
            "description": "Partial local render"
          },
          "401": {
            "description": "Session authentication required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local generated .session-token, never a provider key"
      },
      "localCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mm_session",
        "description": "Bootstrap at /. POST also requires X-MM-CSRF; cannot be expressed as cookie alone."
      }
    }
  },
  "x-workbench-operations": {
    "read": [
      "story.compile",
      "story.score",
      "workbench.context",
      "workbench.get",
      "workbench.reference",
      "workbench.search"
    ],
    "write": [
      "capture.create",
      "motif.create",
      "occurrence.create",
      "project.create",
      "relationship.create",
      "story.create",
      "story.prepare",
      "story.render",
      "story.unlock",
      "story.update",
      "work.create",
      "workbench.review",
      "workbench.seed"
    ],
    "mutation_requirements": [
      "expected_sequence",
      "idempotency_key"
    ],
    "story_mutation_requirements": [
      "expected_revision"
    ],
    "status": "implemented_local_only"
  }
}